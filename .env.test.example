# Copy this file to .env.test and replace values for a local PostgreSQL test database.
# Never point TEST_DATABASE_URI at the development or production database.
TEST_DATABASE_URI=postgresql://postgres:password@localhost:5432/moodjournal_test
JWT_SECRET_KEY=test-only-secret

# Normal Phase 1 tests mock the provider and do not require a real key.
OPENAI_API_KEY=
